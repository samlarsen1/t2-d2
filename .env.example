# Trading212 API
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo
#T212_BASE_URL=https://demo.trading212.com
# Live
T212_BASE_URL=https://live.trading212.com

# Strategy
STRATEGY_MODE=mild
DRY_RUN=true

# Firebase (path to downloaded service account JSON)
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json
FCM_TOPIC=t2d2-trades

# Logging
LOG_LEVEL=INFO
