# Trading212 API
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo
#T212_BASE_URL=https://demo.trading212.com
# Live
T212_BASE_URL=https://live.trading212.com

# Trading
DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# Telegram trade notifications (optional; both must be set)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
